# Live OpenAI generation. In development, Goal Planner uses deterministic demo
# responses when this value is missing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Set to true to force deterministic AI responses. Never enable this on a
# public production deployment.
GOAL_PLANNER_ENABLE_DEMO=false

# Supabase is optional while developing the UI. When either value is missing,
# the app uses browser-local demo storage and does not expose Google login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
